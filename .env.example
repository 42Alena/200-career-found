# Optional: enables live job-description discovery. Without it, the app uses
# clearly marked built-in example job descriptions.
FIRECRAWL_API_KEY=fc_your_firecrawl_api_key

# Optional: enables AI-generated recommendations and learning plans. Without it,
# the app uses deterministic fallback content.
OPENAI_API_KEY=sk_your_openai_api_key
OPENAI_MODEL=gpt-5.1

# Optional: enables voice dictation via ElevenLabs Speech-to-Text. Without it,
# the dictation button shows a "not configured" error and typing still works.
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key
